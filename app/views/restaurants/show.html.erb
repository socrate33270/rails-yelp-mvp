<h1> restaurant </h1>

<li> <%= @restaurant[:name] %> </li>
<li> <%= @restaurant[:address] %> </li>
<li> <%= @restaurant[:category] %> </li>

<h2>Les avis sur ce restaurant</h2>
<% @restaurant_reviews.each do |review| %>
<li> <%= review[:rating] %> </li>
<li> <%= review[:content] %> </li>
<% end %>

<%= simple_form_for [@restaurant, @review] do |f| %>
<%= f.input :rating %>
<%= f.input :content %>
<%= f.submit "Submit restaurant", class: "btn btn-primary" %>
<% end %>
